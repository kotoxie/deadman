# Server
PORT=6680

# ─── REQUIRED: App will refuse to start without these ─────────────
# Master password for login (must be strong, NOT a common word)
MASTER_PASSWORD=<REPLACE: choose a strong unique password>

# Database encryption key (generate with: openssl rand -hex 32)
DB_ENCRYPTION_KEY=<REPLACE: run openssl rand -hex 32>

# ─── Optional — session secret ─────────────────────────────────────
# A 128-char hex secret is auto-generated on first start and stored in
# DATA_DIR/session.secret (mode 0600, owner-read-only). No action needed.
# Set this only if you want a stable secret that survives container
# recreations without a shared data volume.
# SESSION_SECRET=

# ─── TLS / HTTPS ───────────────────────────────────────────────────
# The server always runs HTTPS. By default a self-signed certificate is
# auto-generated on first start and stored in DATA_DIR/tls/.
# Browsers will show a "connection not private" warning for self-signed certs.
#
# To use your own trusted certificate (e.g. from Let's Encrypt):
# TLS_CERT_PATH=/path/to/fullchain.pem
# TLS_KEY_PATH=/path/to/privkey.pem

# ─── Optional ─────────────────────────────────────────────────────
# Data directory (inside container: /app/data)
# DATA_DIR=./data

# Log level: error, warn, info, debug
# LOG_LEVEL=info

# SMTP (can also configure via Settings UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false

# Telegram (can also configure via Settings UI)
# TELEGRAM_BOT_TOKEN=
